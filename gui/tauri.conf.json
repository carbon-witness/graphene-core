{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphene Node",
  "version": "1.0.0",
  "identifier": "org.graphene.node-gui",
  "build": { "frontendDist": "dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Graphene Node", "width": 980, "height": 680, "minWidth": 720, "minHeight": 480, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": false,
    "publisher": "Graphene",
    "copyright": "Copyright (c) 2026 Graphene contributors. MIT License.",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
